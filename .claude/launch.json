{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "--prefix", "app", "dev"],
      "port": 5173
    },
    {
      "name": "digitizer",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "digitizer_service", "--port", "8721"],
      "cwd": "digitizer",
      "port": 8721,
      "url": "http://127.0.0.1:8721",
      "autoPort": false
    },
    {
      "name": "corpus-sxs",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8731", "--bind", "127.0.0.1"],
      "cwd": "digitizer/corpus_runs",
      "port": 8731,
      "url": "http://127.0.0.1:8731",
      "autoPort": false
    },
    {
      "name": "fill-slant-picker",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "tools.eye_pairs", "--serve", "--out", "eye_pairs_out/fill-slant-1108", "--port", "8735"],
      "cwd": "digitizer",
      "port": 8735,
      "url": "http://127.0.0.1:8735",
      "autoPort": false
    },
    {
      "name": "defect-marks",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "tools.defect_marks", "serve", "--kit", "eye_pairs_out/defect-marks-1110", "--port", "8736"],
      "cwd": "digitizer",
      "port": 8736,
      "url": "http://127.0.0.1:8736",
      "autoPort": false
    },
    {
      "name": "defect-marks-1111",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "tools.defect_marks", "serve", "--kit", "eye_pairs_out/defect-marks-1111", "--port", "8737"],
      "cwd": "digitizer",
      "port": 8737,
      "url": "http://127.0.0.1:8737",
      "autoPort": false
    },
    {
      "name": "defect-marks-1112",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "tools.defect_marks", "serve", "--kit", "eye_pairs_out/defect-marks-1112", "--port", "8738"],
      "cwd": "digitizer",
      "port": 8738,
      "url": "http://127.0.0.1:8738",
      "autoPort": false
    }
  ]
