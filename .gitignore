node_modules/
.superpowers/
scratch_*
scratch_corpus/
.claude/worktrees/
.playwright-mcp/
parity_out*/
.claude/settings.local.json

# Local-only acceptance photos (public repo — never publish; spec decision 6).
# Trailing "/*" (not "/") is load-bearing: a bare directory-match pattern
# makes git prune the whole dir from traversal, and a negation line for a
# file inside it below is then never even evaluated (confirmed empirically
# with `git check-ignore -v` while wiring Task 6 — see task-6-report.md).
# The "/*" form still excludes everything by default but keeps the dir
# itself traversable so the README negation below actually takes effect.
digitizer/testdata/photo/acceptance/*
# ...except the dir's own explainer (Task 6) — must follow the exclude
# above to take effect (gitignore negation order rule).
!digitizer/testdata/photo/acceptance/README.md

# Personal font build (node tools/build-embf.mjs --personal) — contains
# ShareAlike / GPL / NonCommercial / license-pulled fonts. Private use is not
# distribution, so these are fine on Kent's machine and must never be committed:
# a fresh clone and CI have no bin-personal/, which is what makes the sellable
# build clean by construction rather than by remembering. See build-embf.mjs.
src/fonts/bin-personal/
src/fonts/manifest-personal.json
app/public/fonts/manifest-personal.json
app/public/fonts/bin-personal/
# Preview PNGs and licence sidecars for the personal-only fonts. These MUST
# stay out of src/fonts/previews/ and src/fonts/<key>.LICENSE.txt, which are
# both committed: a preview is a render of the font, so publishing one for a
# ShareAlike or NonCommercial face is exactly the distribution the build split
# exists to prevent.
src/fonts/previews-personal/
src/fonts/licenses-personal/

# Regenerable outputs of the letterform-fidelity analysis scripts (see
# digitizer/tools/letterform_fidelity/README.md) — the METHOD is tracked, the
# renders and the pickled capture are not.
digitizer/tools/letterform_fidelity/out/

# Regenerable output of tools/artfidelity_self.py — the METHOD and the
# instrument's tests are tracked, a run's own table and CSV are not. The
# authoritative Linux baseline is the art-fidelity-baseline CI job's uploaded
# artifact, not a file someone happened to leave in their checkout.
digitizer/artfid-baseline.csv
digitizer/artfid-baseline.txt

# Regenerable output of tools/artfid_eye_rank.py — renders, sealed scores, and
# the shuffled label mapping. All three rebuild from a fixed seed, and the
# renders are large. The RESULT of a run is written up under docs/ instead
# (docs/artfid-eye-agreement-*.md), which is the part worth reading later.
digitizer/artfid_eye_out/

# Regenerable output of tools/eye_pairs — renders, SEALED arm map and feature
# table, and the picks log. The audit trail of a sitting is copied to
# docs/eye-pairs-<date>/ and committed from there; this directory never is.
# Output of tools/eye_pairs. The renders, the SEALED arm map and the feature
# table are regenerable (hours of compute, but a fixed seed). picks.jsonl is
# NOT: it is Kent's sitting, and until it is copied to docs/eye-pairs-<date>/
# (COOKBOOK "Eye pairs") this directory holds the only copy. Gitignored means
# kept out of the public repo, not safe to delete — CLAUDE.md footgun 5.
digitizer/eye_pairs_out/

# Codex CLI's mirror of the Claude config (.codex/ hooks+agents, .agents/ skills,
# AGENTS.md). Local-only on purpose: AGENTS.md is a stale sed-substituted copy of
# CLAUDE.md whose "Codex" paths do not exist, and .codex/hooks.json hardcodes
# absolute paths to one machine — neither is fit to publish from a PUBLIC repo.
# The hook SCRIPTS under .codex/hooks/ are byte-identical to .claude/hooks/ and
# work; it is only the docs and the launcher paths that are wrong.
# Kent's call 2026-09-15: keep the files, keep them out of the repo.
.codex/
.agents/
AGENTS.md
