 from shapely import affinity
-from shapely.geometry import Point, Polygon
+from shapely.geometry import Point, Polygon, box
+from shapely.ops import unary_union
 
 from digitizer_core import PipelineConfig, get_fabric, machine, plan_stitches
 from digitizer_core import stitches as ST
@@ -466,3 +467,128 @@ def test_a_fabric_with_no_pull_comp_is_untouched_either_way():
                       notes="")
     planned, _ = resolve_overlaps([region(art)], zero, c)
     assert planned[0].polygon.equals(art)
+
+
+# --- Exterior concavities: the same floor the counters already get -----------
+#
+# The interior branch has always held a hole open when pull comp would shrink
+# it below the sewable floor. Nothing asked the same question on the OUTSIDE,
+# so an E's arm slots and an N's crotch closed under exactly the arithmetic an
+# O's counters were protected from.
+
+
+def block_E(slot_mm: float = 0.8) -> Polygon:
+    """A block E: one stem, four arms, three slots of `slot_mm`. The slots are
+    notches in the EXTERIOR boundary — `poly.interiors` is empty for this
+    shape, which is precisely why the hole guard never saw them."""
+    parts = [box(0.0, 0.0, 2.0, 12.0)]
+    y = 0.0
+    while y + 2.6 <= 12.0:
+        parts.append(box(2.0, y, 8.0, y + 2.6))
+        y += 2.6 + slot_mm
+    return unary_union(parts)
+
+
+def slot_gap(shape: Polygon, y0: float, y1: float) -> float:
+    """Height of what is still open in the arm band y0..y1, in mm."""
+    remaining = box(2.0, y0, 8.0, y1).difference(shape)
+    if remaining.is_empty:
+        return 0.0
+    b = remaining.bounds
+    return b[3] - b[1]
+
+
+def test_an_E_keeps_its_arm_slots_through_pull_compensation():
+    """The defect, in the shape that names it. At 0.3 mm pull each side, a
+    0.8 mm slot has 0.6 mm taken out of it and 0.2 mm left — a slot the
+    machine cannot resolve, in artwork that clearly showed one."""
+    art = block_E(0.8)
+    assert not art.interiors, "fixture must have NO interior rings"
+    planned, _ = planned_for(art, directional=False)
+
+    for y0, y1 in ((2.6, 3.4), (6.0, 6.8)):
+        assert slot_gap(art, y0, y1) == pytest.approx(0.8, abs=0.01)
+        assert slot_gap(planned.polygon, y0, y1) == pytest.approx(0.8, abs=0.05), \
+            f"slot {y0}-{y1} closed under compensation"
+
+
+def test_holding_a_pocket_open_can_never_eat_original_artwork():
+    """The safety property the implementation leans on: a pocket is disjoint
+    from the shape, so subtracting it from the grown shell always leaves a
+    result that still contains every bit of the original. Without this,
+    `_largest_polygon` downstream could silently drop half a split shape."""
+    art = block_E(0.8)
+    planned, _ = planned_for(art, directional=False)
+    assert planned.polygon.contains(art.buffer(-1e-9))
+
+
+def test_a_slot_already_under_the_floor_is_left_alone():
+    """Matches the interior branch's own early `continue`: a feature that was
+    already below the sewable floor before compensation is stage 3's call, not
+    this guard's, and inventing protection for it here would resurrect detail
+    the pipeline deliberately dropped."""
+    tiny = block_E(0.05)
+    planned, _ = planned_for(tiny, directional=False)
+    assert slot_gap(planned.polygon, 2.6, 2.65) == 0.0
+
+
+def test_an_O_still_keeps_its_counter():
+    """Regression guard on the branch that already worked — the exterior pass
+    must not disturb interior rings, and `convex_hull - poly` must not
+    double-count a ring the hole loop already holds."""
+    ring = Point(0, 0).buffer(6.0).difference(Point(0, 0).buffer(5.2))
+    assert len(ring.interiors) == 1
+    planned, _ = planned_for(ring, directional=False)
+    assert len(planned.polygon.interiors) == 1, "the counter closed up"
+
+
+def test_a_slot_wide_enough_to_survive_is_still_compensated():
+    """The guard protects features that would CLOSE, not every concave edge.
+    A 3.0 mm slot losing 0.6 mm is compensation working as designed; holding
+    it open too would quietly suppress pull comp on every inward corner in the
+    design."""
+    art = block_E(3.0)
+    planned, _ = planned_for(art, directional=False)
+    gap = slot_gap(planned.polygon, 2.6, 5.6)
+    assert gap == pytest.approx(3.0 - 2 * PULL, abs=0.05), \
+        f"expected the slot to narrow to {3.0 - 2 * PULL}, got {gap}"
+
+
+def test_slot_protection_does_not_depend_on_the_coordinate_axes():
+    """This file already records a defect where compensation rode on STRtree
+    bounding boxes, "so the same artwork sewed differently rotated 45
+    degrees". The pocket envelope must not reintroduce that: an axis-aligned
+    bounding box would, a convex hull does not.
+
+    Asserted as an INVARIANCE between two rotations rather than against a
+    fixed area, because the claim is that the answer does not depend on the
+    axes — a hardcoded number would be a second thing to get wrong and would
+    not test the property."""
+    grew = []
+    for rot in (0.0, 45.0):
+        art = affinity.rotate(block_E(0.8), rot, origin="centroid")
+        planned, _ = planned_for(art, directional=False)
+        grew.append(planned.polygon.area - art.area)
+    assert grew[0] == pytest.approx(grew[1], rel=0.02), \
+        f"grew {grew[0]:.2f} mm2 upright but {grew[1]:.2f} mm2 at 45 deg"
+
+
+def test_a_counter_is_not_held_twice():
+    """`convex_hull - poly` would return an O's counter as an exterior pocket,
+    because a hole is absent from the shape and present in its hull. Held by
+    both loops it is geometrically idempotent but doubles what the
+    HOLE_NEARLY_CLOSED warning reports, and a count that overstates by 2x is
+    how a real 'openings were kept open' signal stops being trusted."""
+    # Inner radius 1.0 mm: the counter is 3.14 mm2, above the 2.25 mm2 floor,
+    # and 0.3 mm of pull would take it to 1.54 mm2 — below. So it is exactly a
+    # counter the hole guard has to hold, which is what makes the count
+    # observable.
+    ring = Point(0, 0).buffer(3.0).difference(Point(0, 0).buffer(1.0))
+    assert len(ring.interiors) == 1
+    _, warnings = resolve_overlaps(
+        [region(ring)], PIQUE,
+        PipelineConfig(overlap_mm=0.25, directional_comp=False))
+    held = [w for w in warnings if w.get("count") is not None
+            and "kept open" in w.get("message", "")]
+    assert held, "the counter should have been held at all"
+    assert held[0]["count"] == 1, f"counted {held[0]['count']} openings, not 1"
