            return min(math.dist(run.points[0], p) for p in run.points[1:4]) \
                <= machine.TIE_STITCH_MM + 1e-6
    
        def locked_tail(run) -> bool:
            return min(math.dist(run.points[-1], p) for p in run.points[-4:-1]) \
                <= machine.TIE_STITCH_MM + 1e-6
    
